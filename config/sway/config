# minimal base sway config

set $mod Mod4
set $alt Mod1
set $left h
set $down j
set $up k
set $right l
set $term ${TERM:-foot}
set $menu ${SWAYMENU:-wmenu-run}
set $bar ${SWAYBAR:-swaybar -b bar-0}
set $flavor ${SWAY_FLAVOR:-classic}

include config-vars.d/*

# sway bar
bar {
    swaybar_command # unset swaybar_command in favor for exec below
    position top
}
exec $bar

# sway flavor (for main keybindings and such)
include $flavor.conf

# default sway config dirs
include config.d/*
include custom.d/*

# sway autostart scripts
exec find $(echo $PATH | tr ':' ' ') -type f -executable -regex '^sway-autostart' -exec sh {} \;
